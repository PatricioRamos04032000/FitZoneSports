# =============================================================================
# FitZone Sports — Variables de entorno del Frontend (React + Vite)
# =============================================================================
# Copiar este archivo a frontend/.env.local y completar los valores.
# Nunca commitear el archivo .env.local real.
# Nota: En Vite, las variables expuestas al cliente deben empezar con VITE_.
# =============================================================================

# URL del proyecto Supabase (Project Settings > API)
# No es secreta, debe apuntar al proyecto correcto.
# Ejemplo: https://tu-proyecto.supabase.co
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave pública de Supabase (anon key o publishable key)
# Se usa para autenticación del cliente en el frontend.
# Obtenerla del panel de Supabase > Settings > API > anon public
VITE_SUPABASE_PUBLISHABLE_KEY=<tu-anon-key-aqui>

# URL base de la API del backend (para llamadas HTTP directas si las hay)
# En desarrollo local: http://localhost:3000
# En producción: https://tu-backend.onrender.com
VITE_API_URL=http://localhost:3000