# FitZone Sports — nombres de las variables
# Este archivo no lleva valores. Copiá las plantillas y completalas ahí:
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env
#
# No commitear backend/.env ni frontend/.env.

# Backend
PORT
APP_PUBLIC_URL
SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY
CORS_ORIGIN
SEED_PASSWORD
TOTP_SEED_ENCRYPTION_KEY

# Frontend
VITE_SUPABASE_URL
VITE_SUPABASE_PUBLISHABLE_KEY
VITE_API_URL
