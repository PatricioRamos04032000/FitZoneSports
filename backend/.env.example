# =============================================================================
# FitZone Sports — Variables de entorno del Backend (NestJS)
# =============================================================================
# Copiar este archivo a backend/.env y completar los valores.
# Nunca commitear el archivo .env real (contiene secretos).
# =============================================================================

# Puerto en el que escucha la API del backend
# Valor por defecto: 3000
PORT=3000

# URL pública del backend (base del checkout simulado S7-T02b).
# Ejemplo local: http://localhost:3000
# En producción: la URL de Render del API.
APP_PUBLIC_URL=http://localhost:3000

# URL del proyecto Supabase (Project Settings > API)
# No es secreta, pero debe apuntar al proyecto correcto.
# Ejemplo: https://tu-proyecto.supabase.co
SUPABASE_URL=https://<project-ref>.supabase.co

# Clave secreta de servicio de Supabase (Project Settings > API Keys > Service Role Key)
# SECRETA: nunca compartir, nunca commitear.
# Obtenerla del panel de Supabase > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Clave anon/public de Supabase (Project Settings > API Keys > anon public)
# Necesaria para POST /auth/register (signUp dispara el mail de confirmación).
# No es el service_role; igual no va en el frontend si usamos BFF.
SUPABASE_ANON_KEY=

# Orígenes del frontend habilitados por CORS, separados por coma.
# Sin definir, se usa http://localhost:5173 (Vite en desarrollo local).
# En producción (Render), usar la URL del frontend en Vercel.
# Ejemplo: http://localhost:5173,https://fitzone.vercel.app
CORS_ORIGIN=http://localhost:5173

# Contraseña común de los usuarios del seed de demo (`npm run seed`).
# No commitear el valor real. Ver documentacion/Seed_Demo_S5.md
SEED_PASSWORD=
