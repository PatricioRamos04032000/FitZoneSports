# Copiar a backend/.env y completar. Nunca commitear el .env real.

PORT=3000

# URL del proyecto Supabase (Project Settings > API). No es secreta.
SUPABASE_URL=https://<project-ref>.supabase.co

# Secret key del proyecto (Project Settings > API Keys). SECRETA: pedirla por Discord.
SUPABASE_SERVICE_ROLE_KEY=

# Orígenes del frontend habilitados por CORS, separados por coma.
# Sin definir usa http://localhost:5173 (Vite). En Render: la URL de Vercel.
CORS_ORIGIN=http://localhost:5173
