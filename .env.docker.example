# =============================================================================
# FitZone Sports — Variables de entorno para Docker Compose
#
# Copiar este archivo a `.env` en la raíz del repositorio y completar los
# valores reales de Supabase antes de ejecutar el seed.
#
# IMPORTANTE: El backend de FitZone Sports se conecta a Supabase (nube), no a
# PostgreSQL local. El servicio `db` en docker-compose.yml es ornamental /
# referencia únicamente. Sin estas credenciales reales, el backend no arranca
# y el seed falla.
# =============================================================================

# Contraseña del Postgres local de referencia (servicio db). La API no se conecta a esa base.
POSTGRES_PASSWORD=postgres

# --- Supabase (OBLIGATORIO para backend y seed) -----------------------------
# URL del proyecto Supabase (Project Settings > API)
# Ejemplo: https://abcdefgh.supabase.co
SUPABASE_URL=https://<project-ref>.supabase.co

# Clave secreta de servicio (service_role) — solo backend, nunca al frontend
SUPABASE_SERVICE_ROLE_KEY=sb_<service-role-key>

# Clave pública (anon) — usada por el frontend para auth del cliente
SUPABASE_ANON_KEY=sb_<anon-key>

# --- Seed ------------------------------------------------------------------
# Contraseña común para los usuarios de prueba del seed de entrega
SEED_PASSWORD=fitzone-demo

# --- Frontend (Vite expone solo variables con prefijo VITE_) ---------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_<publishable-key>
VITE_API_URL=http://localhost:3000

# --- Backend ---------------------------------------------------------------
PORT=3000
APP_PUBLIC_URL=http://localhost:3000
# El navegador en el puerto 80 envía Origin: http://localhost (sin el puerto).
CORS_ORIGIN=http://localhost,http://localhost:5173,http://frontend:80
TOTP_SEED_ENCRYPTION_KEY=

# =============================================================================
# Comandos de uso:
#
#   1. Copiar este archivo: cp .env.docker.example .env
#   2. Completar SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY
#   3. Solo si Avast intercepta HTTPS (CA distinta en cada PC):
#        powershell -ExecutionPolicy Bypass -File scripts/exportar-ca-avast.ps1
#   4. Levantar todo:      docker compose up --build
#   5. Ejecutar el seed:   docker compose --profile seed run --rm seed
# =============================================================================