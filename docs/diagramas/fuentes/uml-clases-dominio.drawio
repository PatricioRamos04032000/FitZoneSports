        <mxCell id="pieObserver" value="ListaEsperaPublisher no guarda observadores. InAppObserver, EmailSimuladoObserver y LogObserver se anotan con @OnEvent(lista-espera.lugar-liberado). El código usa EventEmitter2." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
